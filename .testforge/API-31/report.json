  "frameworks": [
    "vitest"
  ],
  "strategy": {
    "summary": "GET /products filters the in-memory catalogue (120 products, 8 names × 15) by case-insensitive name substring `q`, pages with `limit` (default 20, capped at MAX_LIMIT=50) and `offset`, returns { total, items }, and refuses non-whole limit/offset or limit < 1 with 400. Tests start the real app in-process and call it over HTTP to prove filtering, paging, the cap and the refusals.",
    "inScope": [
      "GET /products query handling: q, limit, offset, total, cap, 400 refusals"
    ],
    "outOfScope": [
      "GET /products/:id and POST /orders (not in the ticket)",
      "Search box UI (no UI in this repo)"
    ],
    "assumptions": [
      "The limit cap is 50 (MAX_LIMIT in src/app.js), not the README's 100: a person confirmed this in earlier runs on API-31 (approved repo note); tests import MAX_LIMIT.",
      "The real app runs in-process on port 0 for every test; nothing is faked. The catalogue is fixed in src/catalogue.js and GET /products does not change it.",
      "Server start/stop moves into a shared helper test/helpers/server.js used by both test/products.test.js and the new spec."
    ],
    "openQuestions": [
      "README.md says limit goes up to 100 while the code caps at 50; the README should be updated (follow-up)."
    ],
    "risks": [
      {
        "description": "Search becomes case-sensitive or prefix-only, so the shop's search box misses products",
        "impact": "high",
        "mitigation": "TC1 uses mixed-case q, TC2 a substring from the middle of a name"
      },
      {
        "description": "total reports the page size instead of all matches, breaking pagination",
        "impact": "high",
        "mitigation": "TC5 asserts total 15 while the page has 5 items"
      },
      {
        "description": "Uncapped limit lets clients pull the whole catalogue",
        "impact": "medium",
        "mitigation": "TC7 asks for more than MAX_LIMIT and expects exactly MAX_LIMIT items"
      },
      {
        "description": "Malformed paging values accepted silently (e.g. 2.5 parsed as 2)",
        "impact": "medium",
        "mitigation": "TC9–TC11 one row per invalid value"
      }
    ],
    "acceptanceCriteria": [
      {
        "id": "AC1",
        "text": "q matches products whose name contains it, case-insensitively; without q every product is listed.",
        "derived": false
      },
      {
        "id": "AC2",
        "text": "Results are paged with limit and offset, the response gives the total number of matches, and limits above MAX_LIMIT (50) are capped.",
        "derived": false
      },
      {
        "id": "AC3",
        "text": "A limit or offset that isn't a whole number, or a limit below 1, is refused with 400.",
        "derived": false
      }
    ],
    "testCases": [
      {
        "id": "TC1",
        "title": "matches q against product names in any case",
        "level": "integration",
        "framework": "vitest",
        "type": "positive",
        "priority": "critical",
        "acceptanceCriteria": [
          "AC1"
        ],
        "preconditions": [
          "app started in-process"
        ],
        "steps": [
          "GET /products?q=kEtTlE&limit=50"
        ],
        "expected": "200, total 15, item names exactly 'Kettle 1'..'Kettle 15' in id order",
        "testData": "q=kEtTlE",
        "targetFile": "test/products-search.test.js",
        "automate": true,
        "rationale": "Core search rule and case-insensitivity"
      },
      {
        "id": "TC2",
        "title": "matches q anywhere inside the name",
