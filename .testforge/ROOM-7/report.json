      "The app's database BookingStore (not in the repo)"
    ],
    "assumptions": [
      "Each refusal's 'why' is checked against the exact BookingError message src/bookings.ts throws, since only the message tells refusals apart.",
      "Tests use a fresh createBookings(memoryStore()) per test; no shared state."
    ],
    "openQuestions": [
      "Room names are matched case-sensitively ('atlas' is refused); the ticket doesn't say whether that is intended."
    ],
    "risks": [
      {
        "description": "Off-by-one at the length or adjacency boundaries lets invalid bookings through or blocks valid ones",
        "impact": "high",
        "mitigation": "TC5–TC8 and TC11 test both sides of each boundary"
      },
      {
        "description": "Cancel by someone else silently deletes a booking",
        "impact": "high",
        "mitigation": "TC13 checks the refusal and that the booking is still listed"
      }
    ],
    "acceptanceCriteria": [
