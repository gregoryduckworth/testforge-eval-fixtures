  "defects": [
    {
      "title": "saveAll returns ids in completion order, not the order of the records",
      "testCaseId": "TC3",
      "file": "test/bulk.test.js",
      "description": "AC3 / src/bulk.js doc: saveAll resolves with the ids in the order of `records`, so callers can pair them by index. Actual: inside Promise.all each callback does `ids.push(await client.save(record))` (src/bulk.js:9), so ids are pushed as saves complete. With the records client's random per-call latency, a later record's save often finishes first and the ids come back reversed.",
      "evidence": "probe_stability (10 shuffled runs): 'saveAll resolves with the ids in the order of the records' failed 2/10 with AssertionError: expected [ 'second', 'first' ] to deeply equal [ 'first', 'second' ] at test/bulk.test.js:10."
    }
